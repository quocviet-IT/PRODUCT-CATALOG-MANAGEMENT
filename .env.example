DATABASE_URL=postgresql://postgres:MAT_KHAU@db.xxxxx.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_STORAGE_BUCKET=catalogue

# Ten tab trong Google Sheet nguon catalogue — BAT BUOC, khong co gia tri
# mac dinh. (Truoc day mac dinh "test": quen khai bao bien nay thi doc nham
# mot tab that su ten "test" ma khong bao loi gi ca.)
CATALOGUE_SHEET_TAB=test

# Service account doc Google Sheet va Drive — TUY CHON o muc getEnv(): thieu
# thi ca ung dung van khoi dong binh thuong, chi rieng tinh nang catalogue-sheet
# tu nem loi khi thuc su dung toi (LoiThieuCauHinhGoogle / LoiThieuSheetId).
# Khoa rieng PEM luu tren MOT dong, xuong dong viet bang \n.
GOOGLE_SERVICE_ACCOUNT_EMAIL=ten@du-an.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
CATALOGUE_SHEET_ID=id_bang_tinh

# Chua co credential Google that? Dat tam gia tri bang tien to tu nhan dien
# "CHUA_CO_..." (vi du CHUA_CO_KHOA_THAT__SE_LOI_KHI_GOI_GOOGLE_API) — test
# tich hop tests/modules/sheet/google.tich-hop.test.ts nhan tien to nay va
# tu bo qua thay vi chay that roi that bai o cong xac thuc.
